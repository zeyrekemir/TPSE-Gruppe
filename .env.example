# Copy to .env, fill in, then `docker compose up -d --build`.
# Afterwards check every connection:  docker compose exec backend python -m app.check_setup
# Every ROBOTS_* line here reaches the backend; an empty value means "off" for optional services.

# --- Required ---
POSTGRES_PASSWORD=
# Long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROBOTS_SECRET_KEY=
# Password for the initial "admin" account (only used while the database has no users), 12+ characters.
ROBOTS_BOOTSTRAP_ADMIN_PASSWORD=
# Address users open the hub at, with https (links in e-mails, the TU-ID redirect).
ROBOTS_PUBLIC_URL=https://robots.example.tu-darmstadt.de
# Port nginx listens on, on the host (put the HTTPS reverse proxy in front of it).
HTTP_PORT=8080

# --- TU-ID single sign-on (OpenID Connect), values from HRZ. Empty issuer = off ---
# Register this redirect URI with HRZ: <ROBOTS_PUBLIC_URL>/api/auth/oidc/callback
ROBOTS_OIDC_ISSUER=
ROBOTS_OIDC_CLIENT_ID=
ROBOTS_OIDC_CLIENT_SECRET=
# Group (as sent in the groups claim) whose members become admins; empty = everyone is a member.
ROBOTS_OIDC_ADMIN_GROUP=
# TU-IDs that always become admins, comma-separated (TU-ID itself sends no groups).
ROBOTS_OIDC_ADMIN_USERS=
# How the secret is sent to the token endpoint: client_secret_basic (OIDC default) or client_secret_post.
ROBOTS_OIDC_TOKEN_AUTH=client_secret_basic
# Claim names, if HRZ uses others than these defaults.
ROBOTS_OIDC_SCOPES=openid profile email
ROBOTS_OIDC_USERNAME_CLAIM=preferred_username
ROBOTS_OIDC_GROUPS_CLAIM=groups
ROBOTS_OIDC_BUTTON_LABEL=TU-ID

# --- LDAP sign-in with username and password. Empty URL = local accounts only ---
# Use ldaps:// so passwords are encrypted on the way.
ROBOTS_LDAP_URL=
ROBOTS_LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=org
ROBOTS_LDAP_ADMIN_GROUP_DN=
ROBOTS_LDAP_EMAIL_ATTRIBUTE=mail
ROBOTS_LDAP_NAME_ATTRIBUTE=cn

# --- E-mail notifications. Empty host = off ---
ROBOTS_SMTP_HOST=
ROBOTS_SMTP_PORT=587
ROBOTS_SMTP_STARTTLS=true
# TLS from the first byte (port 465, as smtp.tu-darmstadt.de) instead of STARTTLS.
ROBOTS_SMTP_SSL=false
ROBOTS_SMTP_USER=
ROBOTS_SMTP_PASSWORD=
ROBOTS_SMTP_FROM=robots@example.tu-darmstadt.de
# Reminder this many minutes before a booking starts (0 = off).
ROBOTS_REMINDER_MINUTES=30

# --- Discord notifications. Empty webhook = off ---
ROBOTS_DISCORD_WEBHOOK_URL=
# Language of the shared channel (de or en); e-mails use each person's own language.
ROBOTS_DISCORD_LANGUAGE=de

# --- Booking rules for members (admins are exempt; 0 = no limit) ---
ROBOTS_MAX_RESERVATION_HOURS=0
ROBOTS_MAX_ADVANCE_DAYS=0

# --- Live status: a robot counts as online if it reported within this many seconds ---
ROBOTS_LIVE_TIMEOUT_SECONDS=90
