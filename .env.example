# Copy to .env and fill in before `docker compose up`.
POSTGRES_PASSWORD=
# Long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROBOTS_SECRET_KEY=
# Password for the initial "admin" account (only used when the database is empty).
ROBOTS_BOOTSTRAP_ADMIN_PASSWORD=

HTTP_PORT=8080

# Optional LDAP. Leave ROBOTS_LDAP_URL empty for local accounts only.
ROBOTS_LDAP_URL=
ROBOTS_LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=org
ROBOTS_LDAP_ADMIN_GROUP_DN=

# Address users open the app at (links in notifications, SSO redirect)
ROBOTS_PUBLIC_URL=http://localhost:8080

# Optional single sign-on (OpenID Connect, e.g. TU-ID). Empty issuer = off.
ROBOTS_OIDC_ISSUER=
ROBOTS_OIDC_CLIENT_ID=
ROBOTS_OIDC_CLIENT_SECRET=
ROBOTS_OIDC_ADMIN_GROUP=

# Optional notifications. Empty = off.
ROBOTS_SMTP_HOST=
ROBOTS_SMTP_PORT=587
ROBOTS_SMTP_USER=
ROBOTS_SMTP_PASSWORD=
ROBOTS_SMTP_FROM=
ROBOTS_DISCORD_WEBHOOK_URL=
# Language of the shared Discord channel (de or en); e-mails use each person's own language.
ROBOTS_DISCORD_LANGUAGE=de

# Optional booking rules for members (0 = no limit)
ROBOTS_MAX_RESERVATION_HOURS=0
ROBOTS_MAX_ADVANCE_DAYS=0
