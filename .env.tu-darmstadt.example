# PEARL Robot Hub at TU Darmstadt: copy to .env on the server, fill in the lines marked FILL IN, then
#   docker compose up -d --build
#   docker compose exec backend python -m app.check_setup
# Public TU values below were taken from HRZ's pages and checked against the live servers (28.10.2026).

# --- Required (FILL IN) ---
POSTGRES_PASSWORD=
ROBOTS_SECRET_KEY=
ROBOTS_BOOTSTRAP_ADMIN_PASSWORD=
# HRZ connects only services under *.tu-darmstadt.de. FILL IN the hub's real address:
ROBOTS_PUBLIC_URL=https://robots.pearl.tu-darmstadt.de
HTTP_PORT=8080

# --- TU-ID (OpenID Connect, Shibboleth IdP of the HRZ) ---
# Discovery: https://login.tu-darmstadt.de/.well-known/openid-configuration
# Test system (for a first try): https://login-test.hrz.tu-darmstadt.de
ROBOTS_OIDC_ISSUER=https://login.tu-darmstadt.de
# FILL IN: the client ID HRZ assigned. The secret goes into the next line on the server only.
ROBOTS_OIDC_CLIENT_ID=
ROBOTS_OIDC_CLIENT_SECRET=
# TU-ID sends the TU-ID as preferred_username, plus name and email; it sends no groups.
ROBOTS_OIDC_SCOPES=openid profile email
ROBOTS_OIDC_USERNAME_CLAIM=preferred_username
ROBOTS_OIDC_TOKEN_AUTH=client_secret_basic
# Admins: FILL IN the TU-IDs that should be admins, comma-separated (e.g. ab12cdef,xy34ghij).
# Everyone else starts as a member; admins can promote people on the Users page.
ROBOTS_OIDC_ADMIN_USERS=
ROBOTS_OIDC_ADMIN_GROUP=
ROBOTS_OIDC_BUTTON_LABEL=TU-ID

# --- LDAP: not needed when TU-ID is used (HRZ publishes no LDAP access for applications) ---
ROBOTS_LDAP_URL=

# --- E-mail via the HRZ mail server ---
# smtp.tu-darmstadt.de, port 465, TLS from the start; user = a TU-ID (e.g. a function account).
# HRZ only accepts mail from the campus network (130.83.0.0/16) or VPN, and only to TU addresses.
ROBOTS_SMTP_HOST=smtp.tu-darmstadt.de
ROBOTS_SMTP_PORT=465
ROBOTS_SMTP_SSL=true
ROBOTS_SMTP_STARTTLS=false
# FILL IN: the TU-ID of the sending account; its password goes into the next line on the server only.
ROBOTS_SMTP_USER=
ROBOTS_SMTP_PASSWORD=
# FILL IN: the sender address belonging to that account.
ROBOTS_SMTP_FROM=
ROBOTS_REMINDER_MINUTES=30

# --- Discord (optional): the webhook URL is a secret, enter it on the server only ---
ROBOTS_DISCORD_WEBHOOK_URL=
ROBOTS_DISCORD_LANGUAGE=de

# --- Booking rules for members (0 = no limit) ---
ROBOTS_MAX_RESERVATION_HOURS=0
ROBOTS_MAX_ADVANCE_DAYS=0
ROBOTS_LIVE_TIMEOUT_SECONDS=90
